# Copy to .env and fill in. deploy/2-app-setup.sh does this for you on the server.
# .env holds secrets: it is ignored by git and must never be committed or pasted into chat.

# "production" turns on secure cookies and refuses to start with unsafe settings.
APP_ENV=development
# A long random string. Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# The public address of the site, including https:// in production. Used in emails and the brochure QR code.
BASE_URL=http://127.0.0.1:8000
TIMEZONE=Asia/Kuala_Lumpur
# Default is data/regsite.db inside the project folder.
# DATABASE_URL=sqlite:////absolute/path/regsite.db

# Mail provider: resend | smtp | console (console only prints emails to the log, for development)
MAIL_PROVIDER=console
MAIL_FROM=Faysal Aziz <registration@register.faysalaziz.com>
# Students' replies go here, and new-registration alerts are sent here.
MAIL_REPLY_TO=faysalabdulaziz@gmail.com
ADMIN_ALERT_EMAIL=faysalabdulaziz@gmail.com

# Resend (https://resend.com): use a "Sending access" key restricted to the verified domain.
RESEND_API_KEY=

# Only if MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Abuse protection (defaults shown)
REGISTRATION_RATE_LIMIT=5
MIN_FORM_SECONDS=3
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
SESSION_HOURS=12
